<Window x:Class="PhotoKeepKill.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keeply · Favorites" Width="820" Height="540" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Canvas}" Foreground="#F4F5F5">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Your favorite photos" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock x:Name="CountText" Text="Your favorites are collected here in Keeply. Photos stay in their original folders; copies made with F go to the separate Favorites folder." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/>
      <TextBlock x:Name="DestinationText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <ListView x:Name="FavoritesList" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="#34393D" Foreground="#F4F5F5"
              SelectionChanged="FavoritesList_SelectionChanged" MouseDoubleClick="FavoritesList_MouseDoubleClick">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Photo" Width="235" DisplayMemberBinding="{Binding FileName}"/>
          <GridViewColumn Header="Original folder" Width="355" DisplayMemberBinding="{Binding FolderPath}"/>
          <GridViewColumn Header="Status" Width="95" DisplayMemberBinding="{Binding Availability}"/>
        </GridView>
      </ListView.View>
    </ListView>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="F copies to this separate folder and advances. U undoes the last action." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
      <Button x:Name="OpenDestinationButton" Grid.Column="1" Content="Open Favorites folder" Click="OpenDestination_Click" Margin="0,0,8,0"/>
      <Button x:Name="ShowLocationButton" Grid.Column="2" Content="Show original" Click="ShowLocation_Click" IsEnabled="False" Margin="0,0,8,0"/>
      <Button x:Name="ChangeDestinationButton" Grid.Column="3" Content="Change folder" Click="ChangeDestination_Click" Margin="0,0,8,0"/>
      <Button x:Name="RemoveButton" Grid.Column="4" Content="Remove from list" Click="Remove_Click" IsEnabled="False" Background="#492B2C" BorderBrush="#754345"/>
    </Grid>
  </Grid>
</Window>
