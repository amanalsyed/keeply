<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>PhotoKeepKill</RootNamespace>
    <AssemblyName>Keeply</AssemblyName>
    <ApplicationIcon>assets\Keeply.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="licensing.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="assets\Keeply.ico" />
  </ItemGroup>
</Project>
