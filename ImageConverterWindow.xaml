<Window x:Class="PhotoKeepKill.ImageConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keeply · Convert images" Width="940" Height="760" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#101214" Foreground="#F4F5F5" AllowDrop="True"
        DragEnter="Window_DragEnter" Drop="Window_Drop" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="DarkDropdownItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#F4F5F5"/>
      <Setter Property="Background" Value="#191C1F"/>
      <Setter Property="Padding" Value="9,7"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#30383B"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#245843"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DarkDropdown" TargetType="ComboBox">
      <Setter Property="Background" Value="#24282B"/>
      <Setter Property="Foreground" Value="#F4F5F5"/>
      <Setter Property="BorderBrush" Value="#34393D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource DarkDropdownItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="False">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                      <Grid>
                        <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" MinWidth="{TemplateBinding ActualWidth}">
                <Border Background="#191C1F" BorderBrush="#34393D" BorderThickness="1" CornerRadius="6" Padding="3">
                  <ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Convert images" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="Create WebP, JPEG, or PNG copies. Your original photos stay untouched." Foreground="#A2A9AD" Margin="0,5,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" Content="← Back to sorting" Click="Close_Click" VerticalAlignment="Center"/>
    </Grid>

    <Border Grid.Row="1" Background="#191C1F" BorderBrush="#282D30" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SOURCE FOLDER" FontSize="10" FontWeight="Bold" Foreground="#8BE0BC"/>
          <TextBlock x:Name="SourceFolderText" Text="Choose or drop a folder of images" Foreground="#E3E7E5" TextTrimming="CharacterEllipsis" Margin="0,5,12,0" ToolTip="Choose or drop a source folder"/>
          <TextBlock x:Name="SourceCountText" Text="JPG, JPEG, PNG, WebP, BMP, GIF, and TIFF · no files scanned yet" FontSize="11" Foreground="#92999F" Margin="0,4,12,0"/>
        </StackPanel>
        <Button x:Name="ChooseSourceButton" Grid.Column="1" Content="Choose source" Click="ChooseSource_Click" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#191C1F" BorderBrush="#282D30" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="CONVERTED COPIES" FontSize="10" FontWeight="Bold" Foreground="#8BE0BC"/>
          <TextBlock x:Name="OutputFolderText" Text="Choose a separate destination folder" Foreground="#E3E7E5" TextTrimming="CharacterEllipsis" Margin="0,5,12,0" ToolTip="Choose where converted copies will be saved"/>
          <CheckBox x:Name="IncludeSubfoldersCheck" Content="Include images in subfolders" Foreground="#C7CECA" Margin="0,8,0,0" IsChecked="False" Checked="IncludeSubfolders_Changed" Unchecked="IncludeSubfolders_Changed"/>
        </StackPanel>
        <Button x:Name="ChooseDestinationButton" Grid.Column="1" Content="Choose destination" Click="ChooseDestination_Click" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,2,0,13">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Output format" VerticalAlignment="Center" Foreground="#D8DEDA" Margin="0,0,12,0"/>
        <ComboBox x:Name="FormatCombo" Grid.Column="1" Height="36" SelectedIndex="0" Style="{StaticResource DarkDropdown}" SelectionChanged="Format_Changed">
          <ComboBoxItem Content="WebP" Tag="webp"/>
          <ComboBoxItem Content="JPEG" Tag="jpg"/>
          <ComboBoxItem Content="PNG" Tag="png"/>
        </ComboBox>
        <TextBlock x:Name="QualityLabel" Grid.Column="2" Text="Quality" VerticalAlignment="Center" Foreground="#D8DEDA" Margin="18,0,12,0"/>
        <ComboBox x:Name="QualityCombo" Grid.Column="3" Height="36" SelectedIndex="1" Style="{StaticResource DarkDropdown}">
          <ComboBoxItem Content="Higher quality · 88" Tag="88"/>
          <ComboBoxItem Content="Balanced · 78" Tag="78"/>
          <ComboBoxItem Content="Smaller files · 60" Tag="60"/>
        </ComboBox>
        <CheckBox x:Name="WebpLosslessCheck" Grid.Column="4" Content="Lossless WebP" Foreground="#C7CECA" VerticalAlignment="Center" Margin="14,0,0,0" Checked="WebpLossless_Changed" Unchecked="WebpLossless_Changed"/>
        <TextBlock Grid.Column="5" Text="Quality affects lossy WebP and JPEG. PNG preserves transparency and is lossless." TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11" Foreground="#92999F" Margin="14,0,0,0"/>
      </Grid>
      <Border Grid.Row="1" Background="#191C1F" CornerRadius="9" Padding="12,9" Margin="0,0,0,10">
        <TextBlock x:Name="RunStatusText" Text="Choose a source and destination folder to begin. Processing stays on this PC." Foreground="#C2CAC6" TextTrimming="CharacterEllipsis"/>
      </Border>
      <ListView x:Name="ResultsList" Grid.Row="2" Background="#191C1F" BorderBrush="#282D30" Foreground="#F4F5F5" BorderThickness="1" Padding="8">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Margin="4,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/>
              <TextBlock Grid.Column="1" Text="{Binding Result}" Foreground="#A2A9AD" TextTrimming="CharacterEllipsis" Margin="12,0" ToolTip="{Binding Detail}"/>
              <TextBlock Grid.Column="2" Text="{Binding SizeChange}" Foreground="#8BE0BC" HorizontalAlignment="Right"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="TotalsText" Text="Ready" VerticalAlignment="Center" Foreground="#C2CAC6"/>
        <Button x:Name="OpenOutputButton" Grid.Column="1" Content="Open destination" Click="OpenOutput_Click" IsEnabled="False" Margin="0,0,8,0"/>
        <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel run" Click="Cancel_Click" IsEnabled="False" Margin="0,0,8,0"/>
        <Button x:Name="StartButton" Grid.Column="3" Content="Convert copies" Click="Start_Click" Background="#245843" BorderBrush="#367A5D" IsEnabled="False"/>
      </Grid>
      <ProgressBar x:Name="ConvertProgress" Grid.Row="1" Minimum="0" Maximum="1" Value="0" Height="4" Margin="0,12,0,0" Background="#292D30" Foreground="#8BE0BC" BorderThickness="0"/>
    </Grid>
  </Grid>
</Window>
